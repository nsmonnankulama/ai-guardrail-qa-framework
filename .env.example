# Database (defaults to a SQLite file inside the backend container volume)
DATABASE_URL=sqlite:///./data/guardrail_qa.db

# Only needed when DATABASE_URL points to Postgres AND you want the backend to
# auto-create the role/database on startup if they don't exist yet. Must be a
# superuser connection. Leave blank to skip auto-provisioning (SQLite, or a
# Postgres you already know exists / don't have admin rights on).
DB_BOOTSTRAP_ADMIN_URL=

# AI Configuration (provider-agnostic via LiteLLM)
# AI_PROVIDER: openai, anthropic, ollama, etc. (informational; LiteLLM infers from AI_MODEL)
AI_PROVIDER=openai
# AI_MODEL: e.g. 'gpt-4o-mini', 'claude-3-5-sonnet-20240620', 'ollama/llama3'
AI_MODEL=gpt-4o-mini
# AI_API_KEY: API key for the selected provider (leave blank for local Ollama)
AI_API_KEY=sk-your-key-here
# AI_BASE_URL: optional custom base URL, e.g. http://localhost:11434 for Ollama
AI_BASE_URL=
